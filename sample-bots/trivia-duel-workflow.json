          "temperature": 0.4
        }
      },
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [580, 520]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.output || $json }}",
        "options": {}
      },
      "name": "Respond to Webhook",
