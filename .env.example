# ==============================================================================
# ChatBot Gallery - Docker Compose Environment Configuration
# ==============================================================================

# Application Port
APP_PORT=3000

# Mock Webhook Server Port (Optional offline bot responses)
MOCK_SERVER_PORT=3001

# Database Configuration:
# - Local SQLite (Default with volume persistence):
DATABASE_URL=file:/app/data/local.db
# - Remote Turso / libSQL Cloud (Optional):
# DATABASE_URL=libsql://your-database-name.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token

# Auto Seed Database with Sample Bots on First Launch (true / false)
AUTO_SEED=true
